clave_manual = input.string("", "Forzar clave (vacio = autodetectar)", group = G_BOT,
     tooltip = "Clave del bot si difiere del ticker: BTC, ETH, XAU...")
ver_gamma   = input.bool(true,  "Dibujar GAMMA (flip · muros · P1..A2)",         group = G_BOT,
     tooltip = "Exposicion GEX modelada; no senal validada.")
ver_griegas = input.bool(true,  "Griegas: vanna/charm/delta/vol-trigger", group = G_BOT,
     tooltip = "Referencias sin ventaja operativa validada.")
ver_obj     = input.bool(true,  "Detalle individual: objetivo externo sin fecha",                 group = G_BOT,
     tooltip = "Referencia externa, no take-profit validado.")
ver_maxpain = input.bool(true, "Dibujar Max Pain de opciones (contexto)", group = G_BOT,
     tooltip = "Max pain de opciones: contexto, no rebote garantizado.")
ver_liq     = input.bool(false, "Dibujar iman de liquidacion y max pain",        group = G_BOT,
     tooltip = "Referencia de liquidacion sin ventaja operativa validada.")
ver_obbot   = input.bool(true,  "Incluir OB del bot (requiere fuente vigente)",              group = G_BOT,
     tooltip = "OB de contexto; fuerza visual no es probabilidad.")
ver_zonasbot= input.bool(true,  "Detalle individual: zonas de regimen sin fecha",     group = G_BOT,
     tooltip = "Regimen descriptivo; zona sin entrada validada.")
ver_vd      = input.bool(true,  "Mostrar el VEREDICTO del panel",                group = G_BOT,
     tooltip = "Veredicto descriptivo, no confianza ni probabilidad.")
ver_lect    = input.bool(true,  "Mostrar que se espera del precio en cada nivel", group = G_BOT)
volcar_bot  = input.bool(true,  "VOLCAR los niveles del bot al agrupador de zonas (confluencia)", group = G_BOT)
volcar_perfil = input.bool(true, "VOLCAR el POC/VAH/VAL del perfil de 24h al agrupador", group = G_BOT)
solo_conf   = input.bool(true, "GRIEGAS y GAMMA: solo donde COINCIDEN con otro nivel", group = G_BOT,
     tooltip = "ON: solo coincidencias; OFF: todos. Dibuja lineas.")
f_min_bot   = input.int(5, "Fuerza minima de la zona de gamma", minval = 0, maxval = 100, group = G_BOT)
// __PINE_LIMPIO_2026_09_22__ SOLO MAXIMA CONVICCION (pedido del usuario). El umbral
// de 2 niveles apilados servia para la ALERTA, pero como criterio de DIBUJO llenaba
// la pantalla: con 2 testigos coincide casi cualquier cosa. Este umbral es aparte y
// gobierna que se ve. 3 = solo zonas donde se apilan tres niveles DISTINTOS.
// __CONVICCION_NO_PREDICE_2026_09_22__ — CORREGIDO: el tooltip anterior afirmaba que
// una zona de 3+ niveles "decide si el precio rebota o si al perderla cae fuerte".
// Se midio y es FALSO. Sobre 41 activos, comparando cada nivel contra la tasa BASE
// de su propia celda de (distancia x volatilidad) -- no contra un placebo desplazado,
// que resulto sesgado -- el apilamiento ANTI-predice, y de forma monotona:
//     n=1 .. +0.31 pp sobre la base      n=4 .. -1.93 pp
//     n=2 .. -0.29 pp                    n=5+ . -4.94 pp
// Es decir: a igual distancia y volatilidad, una zona muy apilada se toca MENOS.
// (Antes habia medido "+14.2 pp a favor" con placebo desplazado 0.4-1.2 %: era un
// artefacto. Los cumulos grandes se forman CERCA del precio, y desplazarlos les
// triplicaba la distancia, cuando la tasa de toque va de 96 % a 9 % segun distancia.)
// Script: forward_test/bt_niveles_base_20260922.py
// POR ESO ESTE PARAMETRO SIGUE EXISTIENDO PERO CAMBIA DE SENTIDO: sirve para LIMPIAR
// la pantalla, no para elegir los niveles buenos. Lo que si separa calidad es la
// FAMILIA del nivel (ver el bloque de evidencia mas abajo).
conv_min    = input.int(3, "Detalle individual: familias minimas (no calidad)",
     minval = 2, maxval = 8, group = G_BOT,
     tooltip = "Minimo de familias para limpiar el dibujo, no calidad.")
ocultar_debiles = input.bool(true, "Detalle individual: ocultar bajo umbral de familias",
     group = G_BOT,
     tooltip = "ON: filtra por familias; OFF: muestra debiles.")

// =============================================================================
//  __EVIDENCIA_EN_EL_PINE_2026_09_22__ · QUE VALE CADA COSA DE ESTE INDICADOR
//  (pedido del usuario: "que respete todo lo que ya sabemos y los hallazgos")
//
//  CON EVIDENCIA MEDIDA A FAVOR
//    · % de toque de cada nivel .... re-medido 2026-09-22 con 365.194 observaciones
//                                    de 41 activos. La tabla anterior SOBREESTIMABA
//                                    hasta 16,5 pp (prometia 41 % a 0,75 sigmas
//                                    cuando lo real es 25 %).
//    · sweep-fade de sesion ........ sin porcentaje causal validado fuera de muestra (barrido del extremo
//                                    de Londres + reclaim).
//    · perfil de volumen 24 h ...... estructural: lo calcula Pine con el grafico. Y
//                                    ademas es la UNICA familia con edge medido: ver
//                                    el ranking de abajo.
//    · confirmacion 1H + 4H ........ zona de compra en 15m: sin confirmar -0,114 %/op
//                                    NETA, solo 1H -0,112, solo 4H -0,146, las DOS
//                                    +0,021. Unica celda neta positiva de la tabla.
//
//  RANKING DE FAMILIAS — __CONVICCION_NO_PREDICE_2026_09_22__
//  Cada familia contra la tasa BASE de su propia celda de (distancia x volatilidad),
//  41 activos, velas de 1 h, horizonte 24 h. En puntos porcentuales de toque:
//        POC .................. +1,31   (24 de 28 celdas a favor)   <- la mejor
//        VAH/VAL .............. +0,67   (25 de 28)
//        sesion previa ........ +0,27   (16 de 28 = moneda al aire)
//        numeros redondos ..... +0,03   (nada)
//        PDH/PDL .............. -0,59   ( 4 de 28)
//        canal 55 ............. -0,97   (10 de 28)
//        max/min SEMANAL ...... -2,27   ( 1 de 28)                  <- la peor
//  Los efectos son CHICOS (1 pp), pero consistentes celda a celda, que es la firma de
//  algo real y no de ruido. Consecuencia practica: el perfil de volumen manda; el
//  maximo/minimo semanal conviene mirarlo como referencia, no como nivel operable.
//  Script: forward_test/bt_niveles_base_20260922.py
//
//  MECANISMO SIN EDGE PROPIO (mapa, no senal)
//    · gamma y griegas ............. los cumulos existen; sus pesos dieron DSR 0 %.
//    · order blocks del bot ........ corregido el sesgo, rinde IGUAL QUE EL AZAR.
//    · zonas por regimen ........... el regimen separa; la zona sola no.
//
//  CON EVIDENCIA EN CONTRA (por eso apagado o degradado)
//    · iman de liquidacion ......... Sharpe negativo en 8 de 8 cohortes. Apagado.
//    · objetivo como take-profit ... poner destino RESTA: +1,096 sin TP contra
//                                    +0,779 con el canal como TP (n=2.573).
//    · score del veredicto ......... el score mas alto rindio PEOR.
//
//  LA CADENCIA MINIMA, medida 2026-09-22 y es lo mas util de todo el archivo:
//  el peaje de ejecucion (0,19 %/op = 0,110 de comisiones + 0,077 de slippage real)
//  es FIJO por operacion, y la esperanza BRUTA crece con el tiempo que se aguanta:
//
//    aguantar   0,2 d    1 d     2 d     4 d     8 d    16 d
//    E bruta   -0,027  +0,072  +0,140  +0,254  +0,480  +0,536
//    E NETA    -0,217  -0,118  -0,050  +0,064  +0,290  +0,346
//
//  El punto de equilibrio esta en ~3 DIAS de tenencia. Por debajo de eso NINGUNA
//  regla de esta familia paga el peaje, por buena que sea la senal -- y eso explica
//  por que fallaron las cuatro candidatas rapidas que se probaron (funding a 24 h,
//  reversion, momentum transversal semanal, rebote en niveles a 12 h).
//  CONSECUENCIA PARA QUIEN MIRA ESTE INDICADOR: los niveles sirven para ELEGIR EL
//  PRECIO de una operacion que ya se decidio aguantar dias. Usarlos para entrar y
//  salir dentro del dia es pagar 0,19 % por cada intento contra un movimiento que
//  en promedio no llega a eso.
//
//  MEDIDO 2026-09-22 CON EL CONTROL CORRECTO (el mismo nivel DESPLAZADO 0,4-1,2 %,
//  o sea a la misma distancia pero sin estructura). 41 activos, 1 h:
//
//    familia            ¿atrae? (toca - placebo)   ¿rebota? (edge)
//    POC 24 h ........   +2,4 pp                    +0,010  (t 0,53)
//    VAH / VAL .......   +1,2 pp                    -0,001
//    sesion previa ...   +0,5 pp                    -0,009
//    PWH / PWL .......   -0,6 pp                    +0,009
//    PDH / PDL .......   -0,7 pp                    -0,043  (t -2,67)
//    numeros redondos    -0,8 pp                    -0,052   <- control psicologico
//    canal 55 ........   -1,1 pp                    -0,066  (t -3,53)
//    liquidacion .....   -0,7 pp                    -0,004
//
//  NINGUN nivel sirve de BARRERA: los tres edges significativos son NEGATIVOS, o sea
//  que el precio rebota MENOS ahi que en un nivel corrido al azar. El precio ATRAVIESA.
//  El POC es el unico con propiedad medible y es de IMAN, no de rebote: sirve como
//  DESTINO. Y los numeros redondos, puestos como control, se comportan igual que los
//  niveles "reales": si PDH/PDL tuviera algo especial, tendria que separarse de ellos.
//  Script: forward_test/bt_niveles_validacion_20260922.py
//
//  LO QUE NO ESTA ACA, y es a proposito: la ruptura Donchian intradia (tortugas) en
//  5m/15m rinde EXACTAMENTE lo mismo que entrar al azar (edge +0,001 / -0,001 sobre
//  4.254-8.541 campanas), en 1 h pierde y en 4 h es cero. Solo el diario aporta algo
//  y ahi el problema es que pide anios para probarse.
// =============================================================================

G_BOTC = "00b · COLORES DE LOS NIVELES DEL BOT"
c_tg   = input.color(color.new(#e3b341, 0), "Objetivo",        group = G_BOTC)
c_liq  = input.color(color.new(#db61a2, 0), "Liquidez",        group = G_BOTC)
c_p    = input.color(color.new(#3fb950, 0), "Gamma P (estabiliza)", group = G_BOTC)
c_n    = input.color(color.new(#f85149, 0), "Gamma N (expande)",    group = G_BOTC)
c_a    = input.color(color.new(#00c2ff, 0), "Gamma A (pesada)",     group = G_BOTC)
c_flip = input.color(color.new(#d29bff, 0), "Gamma flip",      group = G_BOTC)
c_muro = input.color(color.new(#ffa657, 0), "Call / put wall", group = G_BOTC)
c_van  = input.color(color.new(#7ee787, 0), "Vanna",           group = G_BOTC)
c_cha  = input.color(color.new(#ffd866, 0), "Charm",           group = G_BOTC)
c_del  = input.color(color.new(#79c0ff, 0), "Delta",           group = G_BOTC)
c_vtr  = input.color(color.new(#ff7b72, 0), "Vol trigger",     group = G_BOTC)
c_obl  = input.color(color.new(#00c9a7, 0), "OB del bot · demanda", group = G_BOTC)
c_obs  = input.color(color.new(#8e294f, 0), "OB del bot · oferta",  group = G_BOTC)
c_zc   = input.color(color.new(#2ea043, 0), "Zona de compra",  group = G_BOTC)
c_zv   = input.color(color.new(#da3633, 0), "Zona de venta",   group = G_BOTC)
largo_bot  = input.int(70, "Largo de las lineas del bot (barras)", minval = 5, maxval = 500, group = G_BOTC)
txt_bot    = input.bool(true, "Etiquetas con nombre y distancia", group = G_BOTC)
dashShow = input.bool(true, "Panel unico arriba a la derecha", group = "Panel unico")
dashSize = input.string("Mini", "Tamano", options = ["Mini", "Chica", "Normal"], group = "Panel unico")
dashDetail = input.bool(false, "Filas ampliadas de contexto", group = "Panel unico")

// ───────────────────────────── parseo del bloque ─────────────────────────────
f_num(string s) =>
    v = str.tonumber(s)
    na(v) ? 0.0 : v

// Base del ticker del grafico: se le sacan el sufijo de perpetuo y la moneda de
// cotizacion. BINANCE:TQQQUSDT.P -> "TQQQUSDT.P" -> "TQQQUSDT" -> "TQQQ".
tick_base() =>
    string t = str.upper(syminfo.ticker)
    for suf in array.from(".P", ".PS", "PERP", "_PERP")
        if str.endswith(t, suf)
            t := str.substring(t, 0, str.length(t) - str.length(suf))
    for q in array.from("USDT", "USDC", "USD", "BUSD", "USDP")
        if str.endswith(t, q) and str.length(t) > str.length(q)
            t := str.substring(t, 0, str.length(t) - str.length(q))
    t

// ★ BUG CORREGIDO 2026-09-13 (lo vio el usuario: "en TQQQUSDT.P no veo los
//   niveles"). Antes se tomaba el PRIMER bloque cuya clave estuviera CONTENIDA en
//   el ticker. Pero "TQQQUSDT.P" contiene "QQQ" ademas de "TQQQ", y QQQ aparece
//   ANTES en los datos: el grafico de TQQQ (~71) terminaba dibujando los niveles
//   de QQQ (~714), diez veces arriba, o sea fuera de pantalla. Parecia "sin
//   niveles" y en realidad eran los del activo equivocado.
// FIX en dos pasadas:
//   1) coincidencia EXACTA contra la base del ticker (TQQQ == TQQQ);
//   2) si no hay exacta, la clave MAS LARGA que este contenida (TQQQ le gana a
//      QQQ siempre, sin importar el orden en que vengan los datos).
bloque_para(string txt, string forzada) =>
    string res = ""
    if str.length(txt) > 0
        string tk   = str.upper(syminfo.ticker)
        string base = tick_base()
        string fz   = str.upper(str.trim(forzada))
        partes = str.split(txt, ";")
        int mejor = 0
        for i = 0 to array.size(partes) - 1
            p = array.get(partes, i)
            campos = str.split(p, "~")
            if array.size(campos) > 1
                clave = str.upper(str.trim(array.get(campos, 0)))
                if str.length(fz) > 0
                    if fz == clave
                        res := p
                else if clave == base                       // 1) exacta
                    res := p
                    mejor := 999
                else if mejor < 999 and str.contains(tk, clave) and str.length(clave) > mejor
                    res := p                                // 2) la mas larga
                    mejor := str.length(clave)
    res

// El bloque se resuelve UNA sola vez (el ticker no cambia): partir la cadena
// entera en cada barra costaria el limite de ejecucion del script.
var string BLOQUE = bloque_para(datos, clave_manual)
// Tiny same-snapshot BTS projection avoids cloning all market data into15m.
var string OB_BLOQUE = bloque_para(str.length(str.trim(datos_manual)) > 0 ? datos_manual : OB_TIMES_EMBEBIDOS, clave_manual)

campos_de(string bloque, string etiq) =>
    out = array.new_string()
    if str.length(bloque) > 0
        cs = str.split(bloque, "~")
        for i = 1 to array.size(cs) - 1
            c = array.get(cs, i)
            if str.startswith(c, etiq + ":")
                v = str.split(c, ":")
                for j = 1 to array.size(v) - 1
                    array.push(out, array.get(v, j))
    out

// First matching field only, matching campos_de(...)[0] without allocating arrays.
valor_de(string bloque, string etiq) =>
    int at = str.pos(bloque, "~" + etiq + ":")
    float result = 0.0
    if not na(at)
        string tail = str.substring(bloque, at + str.length(etiq) + 2)
        int colon = str.pos(tail, ":")
        int tilde = str.pos(tail, "~")
        int stop = math.min(na(colon) ? str.length(tail) : colon, na(tilde) ? str.length(tail) : tilde)
        result := f_num(str.substring(tail, 0, stop))
    result

// =============================================================================
//  PARTE 1 · SWING  (z-score + SOTT + CVD + MACD + 2-pole + score)
// =============================================================================
zlen = input.int(75, "Z-Score lookback", group = "Z")
zthr = input.float(1.5, "Z umbral salida del extremo (+/-)", step = 0.1, group = "Z")
zdeep = input.float(2.0, "Z profundo para A+ (+/-)", step = 0.1, group = "Z")
zwin = input.int(6, "Ventana: toco el extremo en ultimas N velas", group = "Z")
sK   = input.int(200, "SOTT %K length", group = "SOTT")
sSm  = input.int(20, "SOTT suavizado (VIDYA)", group = "SOTT")
zone = input.float(40, "SOTT zona (k<=zona barato / >=100-zona caro)", group = "SOTT")
nonew = input.bool(true, "Anti-cuchillo: no entrar si hace nuevo minimo/maximo de 20", group = "Filtro")
propW   = input.int(20, "Ventana proporcion de flujo (velas)", group = "Filtro")
propThr = input.float(0.5, "Umbral proporcion compra/venta (proxy OHLCV)", step = 0.05, group = "Filtro")
useSlope = input.bool(false, "Exigir SOTT subiendo/bajando", group = "Filtro")

// ---------- Z-SCORE ----------
basis = ta.sma(close, zlen)
dev   = ta.stdev(close, zlen)
z     = dev > 0 ? (close - basis) / dev : 0.0

// ---------- SOTT (VIDYA de stoch, = tu config; k 0..100) ----------
f_cmo(src, len) =>
    mom = src - src[1]
    su  = math.sum(mom > 0 ? mom : 0.0, len)
    sd2 = math.sum(mom < 0 ? -mom : 0.0, len)
    (su + sd2) == 0.0 ? 0.0 : 100.0 * (su - sd2) / (su + sd2)
f_vidya(src, len) =>
    alpha = 2.0 / (len + 1)
    kk = math.abs(f_cmo(src, 9)) / 100.0
    var float v = na
    v := na(v[1]) ? src : alpha * kk * src + (1.0 - alpha * kk) * v[1]
    v
k = f_vidya(ta.stoch(close, high, low, sK), sSm)

// ---------- CVD / flujo (delta por vela) ----------
rng  = math.max(high - low, syminfo.mintick)
delt = volume * (close - open) / rng
cvd3 = delt + delt[1] + delt[2]

// ---------- MACD (marca ENTRADA FUERTE en 5m) ----------
grpM = "MACD (entrada fuerte 5m)"
showStrong = input.bool(true, "Marcar ENTRADA FUERTE (cruce MACD desde extremo)", group = grpM)
mFast = input.int(12, "MACD rapido", group = grpM)
mSlow = input.int(26, "MACD lento", group = grpM)
mSig  = input.int(9,  "MACD senal", group = grpM)
[macdLine, sigLine, _histLine] = ta.macd(close, mFast, mSlow, mSig)
macdXup = ta.crossover(macdLine, sigLine) and macdLine < 0
macdXdn = ta.crossunder(macdLine, sigLine) and macdLine > 0
htfTF = input.timeframe("60", "TF superior para el MACD (usar 60 si operas en 5m/15m)", group = grpM)
// ---------- RSI + confirmaciones del TF SUPERIOR (SOTT-1h, CVD-1h) ----------
// ★ RESTAURADO 2026-09-13: al revertir la consolidacion del TF superior este
//   bloque se fue con el corte y quedaron `useRsiGen`, `useHtfGen`, `rsiExitL` y
//   `rsiExitS` usados pero sin declarar (CE10272).
grpH = "RSI + TF superior (SOTT/CVD 1h)"
rsiLen = input.int(14, "RSI length", group = grpH)
rsiLo  = input.float(30, "RSI sobreventa (LONG)", group = grpH)
rsiHi  = input.float(70, "RSI sobrecompra (SHORT)", group = grpH)
useRsiGen = input.bool(false, "RSI como generador adicional", group = grpH)
useHtfGen = input.bool(false, "SOTT-1h como GENERADOR (union, captura clusters ej 29/7)", group = grpH)
rsiV = ta.rsi(close, rsiLen)
rsiExitL = rsiV > rsiLo and ta.lowest(rsiV, 6)[1] <= rsiLo
rsiExitS = rsiV < rsiHi and ta.highest(rsiV, 6)[1] >= rsiHi

// ★ REVERTIDO 2026-09-13. Yo habia juntado las CUATRO lecturas del TF superior
//   en UNA llamada con tupla, creyendo que ahorraba tokens. Hizo lo contrario:
//   de 115.113 a 136.404. Una `request.security` con tupla compila el cuerpo
//   ENTERO de la funcion una vez POR SALIDA, asi que f_htf_todo() (macd + vidya
//   + stoch + delta) se compilaba 4 veces. Separadas, cada llamada compila SOLO
//   lo suyo. Menos llamadas NO es menos tokens: lo que importa es el TAMANO de
//   la expresion pedida.
f_hmacd_bull() =>
    [ml, sl, _h] = ta.macd(close, mFast, mSlow, mSig)
    ml > sl
f_hmacd_bear() =>
    [ml, sl, _h] = ta.macd(close, mFast, mSlow, mSig)
    ml < sl
f_htf_k() => f_vidya(ta.stoch(close, high, low, sK), sSm)
f_htf_cvd() =>
    dd = volume * (close - open) / math.max(high - low, syminfo.mintick)
    dd + dd[1] + dd[2]
// A scalar-field object shares the HTF context without tuple-output expansion.
type SwingHtf
    bool bull
    bool bear
    float k
    float cvd
f_swingHtf() =>
    [ml, sl, unusedHistogram] = ta.macd(close, mFast, mSlow, mSig)
    float hk = f_htf_k()
    float cvd = f_htf_cvd()
    SwingHtf.new((ml > sl)[1], (ml < sl)[1], hk[1], cvd[1])
//  __FIX_RE10041_2026_10_06__ mismo caso que RefMap15 (ver mas abajo): si el TF superior todavia
//  no cerro una vela, esto viene `na` y leer un campo es error de EJECUCION. Respaldo neutro:
//  k = 50 deja en false tanto "barato" (k<=zone) como "caro" (k>=100-zone).
SwingHtf _swingCrudo = request.security(syminfo.tickerid, htfTF, f_swingHtf(), lookahead = barmerge.lookahead_on)
SwingHtf swingHtf = na(_swingCrudo) ? SwingHtf.new(false, false, 50.0, 0.0) : _swingCrudo
bool htfMacdBull = swingHtf.bull
bool htfMacdBear = swingHtf.bear
float htfK = swingHtf.k
float htfCvd = swingHtf.cvd
htfSottCheapL = htfK <= zone
htfSottExpS   = htfK >= 100 - zone
htfCvdBuyL  = htfCvd > 0
htfCvdSellS = htfCvd < 0

// ---------- __MTF_1H_MAS_4H_2026_09_22__ · la 2a temporalidad superior ----------
// POR QUE EXISTE ESTO. Medido sobre 58 activos en 15m con salida a 12 h, contra el
// MISMO nivel desplazado como placebo (forward_test/bt_mtf_confirmacion_20260922.py):
//
//     zona de compra sin confirmar ....... E NETA -0.114 %/op
//     zona de compra confirmada solo 1H .. E NETA -0.112
//     zona de compra confirmada solo 4H .. E NETA -0.146
//     zona de compra confirmada 1H Y 4H .. E NETA +0.021   <- la UNICA positiva
//
// O sea: una sola temporalidad superior no alcanza, y el indicador tenia una sola.
// Exigir las DOS es lo que lleva una zona de compra de perder a apenas positiva.
//
// DOS ADVERTENCIAS QUE VAN CON EL DATO, porque tambien se midieron:
//   1. El `edge` contra el nivel desplazado NO crece al bajar por esa tabla (-0.010
//      -> -0.015). La confirmacion mejora el MOMENTO, no el LUGAR: el nivel sigue sin
//      ser mejor que un nivel corrido al azar.
//   2. Las zonas de VENTA no dan positivo en NINGUNA celda (la mejor, solo 1H, es
//      -0.160 neta). Por eso abajo la exigencia se aplica al LONG y el SHORT se
//      rotula, pero no se promociona a maxima conviccion por tener 1H+4H.
htf2TF = input.timeframe("240", "Segunda temporalidad superior", group = grpM)
htf2K = request.security(syminfo.tickerid, htf2TF, f_htf_k()[1], lookahead = barmerge.lookahead_on)
htf2CheapL = htf2K <= zone
htf2ExpS   = htf2K >= 100 - zone
mtfBothL = htfSottCheapL and htf2CheapL
mtfBothS = htfSottExpS   and htf2ExpS
exigirMtf = input.bool(true, "Exigir 1H Y 4H para MAX LONG", group = grpM)

// ---------- tendencia larga (EMA200) + movimiento brusco ----------
ema200v = ta.ema(close, 200)
grpB    = "Bruscos / tendencia"
noShortAbove = input.float(1.5, "Bloquear short sobre EMA200 +X%", group = grpB)
sharpN  = input.int(6, "Movimiento brusco: velas", group = grpB)
sharpThr = input.float(2.5, "Movimiento brusco: % en esas velas", step = 0.5, group = grpB)
showSharp = input.bool(true, "Marcar caida/subida BRUSCA (V estirada)", group = grpB)
retN = (close - close[sharpN]) / close[sharpN] * 100
distE200 = (close - ema200v) / ema200v * 100

// ---------- Trend Filter 2-pole (BigBeluga) ----------
grp2 = "Trend 2-pole (mejora 1h)"
use2pole = input.bool(false, "2-pole: exigir filtro de tendencia", group = grp2)
tpLen  = input.int(20, "2-pole length", group = grp2)
tpDamp = input.float(0.9, "2-pole damping", step = 0.01, group = grp2)
tpRF   = input.int(5, "2-pole rising/falling", group = grp2)
showTrend2p = input.bool(true, "Ver LINEA 2-pole (BigBeluga) en el grafico", group = grp2)
tpBands = input.float(1.0, "2-pole bands (ATR)", step = 0.1, minval = 0.5, group = grp2)
tpUpCol  = input.color(color.lime, "arriba", inline = "tpc", group = grp2)
tpDnCol  = input.color(color.red, "abajo", inline = "tpc", group = grp2)
tpNeuCol = input.color(color.yellow, "neutro", inline = "tpc", group = grp2)
tpBarCol = input.bool(false, "colorear velas", inline = "tpf", group = grp2)
tpSig    = input.bool(false, "senales (triangulos)", inline = "tpf", group = grp2)
tpOmega = 2.0 * math.pi / tpLen
tpAlpha = tpDamp * tpOmega
tpBeta  = math.pow(tpOmega, 2)
var float tpf1 = na
var float tpf2 = na
tpf1 := nz(tpf1[1]) + tpAlpha * (close - nz(tpf1[1]))
tpf2 := nz(tpf2[1]) + tpBeta * (tpf1 - nz(tpf2[1]))
var int tpRise = 0
var int tpFall = 0
tpRise := tpf2 > tpf2[2] ? tpRise + 1 : 0
tpFall := tpf2 < tpf2[2] ? tpFall + 1 : 0
tp2okL = not use2pole or (tpFall < tpRF)
tp2okS = not use2pole or (tpRise < tpRF)
tp2atr = ta.atr(200) * tpBands
tp2up = tpf2 > tpf2[2]
tp2dn = tpf2 < tpf2[2]
tp2col = tp2up ? color.from_gradient(tpRise, 0, 15, tpNeuCol, tpUpCol) : tp2dn ? color.from_gradient(tpFall, 0, 15, tpNeuCol, tpDnCol) : tpNeuCol
plot(showTrend2p ? tpf2 : na, "Trend 2-pole", color = tp2col, linewidth = 3)
plotshape(showTrend2p and tpFall >= tpRF ? tpf2 + tp2atr : na, "2p Falling", style = shape.circle, location = location.absolute, color = tp2col)
plotshape(showTrend2p and tpRise >= tpRF ? tpf2 - tp2atr : na, "2p Rising", style = shape.circle, location = location.absolute, color = tp2col)
tp2sigUp = ta.crossover(tpRise, tpRF) and barstate.isconfirmed and tpSig and showTrend2p
tp2sigDn = ta.crossover(tpFall, tpRF) and barstate.isconfirmed and tpSig and showTrend2p
plotshape(tp2sigUp ? tpf2[1] - tp2atr : na, "2p sig up", style = shape.triangleup,   location = location.absolute, color = tp2col, size = size.tiny, offset = -1)
plotshape(tp2sigDn ? tpf2[1] + tp2atr : na, "2p sig dn", style = shape.triangledown, location = location.absolute, color = tp2col, size = size.tiny, offset = -1)
barcolor(tpBarCol and showTrend2p ? tp2col : na)

// ---------- ENTRADA: 2 niveles ----------
zexitL = z > -zthr and ta.lowest(z, zwin)[1] <= -zthr
zexitS = z < zthr and ta.highest(z, zwin)[1] >= zthr
okLowL  = not nonew or (low > ta.lowest(low, 20)[1])
okHighS = not nonew or (high < ta.highest(high, 20)[1])
f2u = (nz(delt) > 0 and nz(delt[1]) > 0) ? 1 : 0
f2d = (nz(delt) < 0 and nz(delt[1]) < 0) ? 1 : 0
buyC = math.sum(f2u, propW)
sellC = math.sum(f2d, propW)
totC = buyC + sellC
propBuy = totC > 0 ? buyC / totC : 0.5
flowOkL = propBuy >= propThr
flowOkS = propBuy <= 1 - propThr
slopeOkL = not useSlope or (k > k[1])
slopeOkS = not useSlope or (k < k[1])
noShortOk = close <= ema200v * (1 + noShortAbove / 100)
longGen  = (useRsiGen and rsiExitL and okLowL) or (useHtfGen and htfSottCheapL and k <= zone and z > z[1] and close > open and okLowL)
shortGen = (useRsiGen and rsiExitS and okHighS) or (useHtfGen and htfSottExpS and k >= 100 - zone and z < z[1] and close < open and okHighS)
longSig  = (zexitL and k <= zone and okLowL and flowOkL and slopeOkL and tp2okL) or longGen
shortSig = ((zexitS and k >= 100 - zone and okHighS and flowOkS and slopeOkS and tp2okS) or shortGen) and noShortOk
longNew  = longSig and not longSig[1]
shortNew = shortSig and not shortSig[1]
deepL = ta.lowest(z, zwin)[1] <= -zdeep
deepS = ta.highest(z, zwin)[1] >= zdeep
longAplus  = longNew and deepL and cvd3 > 0
shortAplus = shortNew and deepS and cvd3 < 0

// EXTREMO PROFUNDO (piso/techo z>=4-5 en V)
deepZ = input.float(4.0, "Extremo PROFUNDO: |z| >=", group = "Filtro")
showDeep = input.bool(true, "Marcar pisos/techos profundos (bandera)", group = "Filtro")
deepPiso  = showDeep and ta.lowest(z, 6) <= -deepZ and z > z[1] and close > open and k <= 45
deepTecho = showDeep and ta.highest(z, 6) >= deepZ and z < z[1] and close < open and k >= 55
deepPisoNew  = deepPiso and not deepPiso[1]
deepTechoNew = deepTecho and not deepTecho[1]
plotshape(deepPisoNew,  "PISO PROFUNDO",  style = shape.flag, location = location.belowbar, color = color.new(color.yellow, 0),   size = size.normal)
plotshape(deepTechoNew, "TECHO PROFUNDO", style = shape.flag, location = location.abovebar, color = color.new(color.orange, 0),   size = size.normal)
alertcondition(deepPisoNew,  "PISO PROFUNDO (z fuerte)",  "TQQQ giro desde piso profundo; sin probabilidad calibrada")
alertcondition(deepTechoNew, "TECHO PROFUNDO (z fuerte)", "TQQQ giro desde techo profundo; sin probabilidad calibrada")

// ---------- MOVIMIENTO BRUSCO (V estirada) ----------
sharpDrop = showSharp and retN <= -sharpThr and distE200 < 0 and z > z[1] and close > open and k <= 45
sharpRise = showSharp and retN >= sharpThr and distE200 > 0 and z < z[1] and close < open and k >= 55
sharpDropNew = sharpDrop and not sharpDrop[1]
sharpRiseNew = sharpRise and not sharpRise[1]
plotshape(sharpDropNew, "CAIDA BRUSCA (fade LONG)",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.aqua, 0),   size = size.small)
plotshape(sharpRiseNew, "SUBIDA BRUSCA (fade SHORT)", style = shape.triangledown, location = location.abovebar, color = color.new(color.orange, 0), size = size.small)
alertcondition(sharpDropNew, "CAIDA BRUSCA (fade LONG)",  "TQQQ giro tras caida brusca bajo EMA200")
alertcondition(sharpRiseNew, "SUBIDA BRUSCA (fade SHORT)", "TQQQ subida brusca sobre EMA200 -> fade SHORT (mas debil, cuidado)")

plotshape(longNew,  "LONG",  style = shape.circle, location = location.belowbar, color = color.new(color.lime, 0), size = size.tiny)
plotshape(shortNew, "SHORT", style = shape.circle, location = location.abovebar, color = color.new(color.red, 0),  size = size.tiny)

// ---------- ENTRADA FUERTE (cruce MACD 5m desde extremo) ----------
strongLong  = showStrong and longNew  and ta.barssince(macdXup) <= 1
strongShort = showStrong and shortNew and ta.barssince(macdXdn) <= 1
convHtfL = htfSottCheapL and htfCvdBuyL
convHtfS = htfSottExpS   and htfCvdSellS
// __MTF_1H_MAS_4H_2026_09_22__ — el MAX LONG ahora pide ademas que la 4H acompane.
// Es la unica celda con esperanza NETA positiva de la tabla medida (+0.021 contra
// -0.114 sin confirmar). El MAX SHORT NO recibe el mismo tratamiento a proposito: las
// zonas de venta no dieron positivo en ninguna celda, asi que exigirle 4H filtraria
// operaciones sin evidencia de que mejore nada.
maxLong  = showStrong and longNew  and ((strongLong  and htfMacdBull) or convHtfL) and (not exigirMtf or mtfBothL)
maxShort = showStrong and shortNew and ((strongShort and htfMacdBear) or convHtfS)
alertcondition(strongLong,  "TQQQ ENTRADA FUERTE LONG",  "TQQQ LONG swing + cruce MACD5m; sin probabilidad calibrada")
alertcondition(strongShort, "TQQQ ENTRADA FUERTE SHORT", "TQQQ SHORT swing + cruce MACD5m; sin probabilidad calibrada")
alertcondition(maxLong,  "TQQQ ENTRADA MAX LONG",  "TQQQ LONG MACD5m + MACD1h; sin probabilidad calibrada")
alertcondition(maxShort, "TQQQ ENTRADA MAX SHORT", "TQQQ SHORT MACD5m + MACD1h; sin probabilidad calibrada")

// ---------- DIVERGENCIA de DELTA/CVD + SCORE de CONFIABILIDAD (0-100) ----------
grpD = "Divergencia + Score de confiabilidad"
showDiv   = input.bool(true, "Detectar divergencia de delta/CVD", group = grpD)
divN      = input.int(2, "Divergencia: pivotes (n)", group = grpD)
scoreThr  = input.int(60, "Umbral score descriptivo (puntos, no %)", minval = 0, maxval = 100, group = grpD)
showScore = input.bool(true, "Etiqueta con el score en cada entrada", group = grpD)
cvdHist = math.sum(delt, 20)
pvL = ta.pivotlow(low, divN, divN)
pvH = ta.pivothigh(high, divN, divN)
pvLb = not na(pvL)
pvHb = not na(pvH)
bullDiv = showDiv and ta.valuewhen(pvLb, low[divN], 0) < ta.valuewhen(pvLb, low[divN], 1) and ta.valuewhen(pvLb, cvdHist[divN], 0) > ta.valuewhen(pvLb, cvdHist[divN], 1)
bearDiv = showDiv and ta.valuewhen(pvHb, high[divN], 0) > ta.valuewhen(pvHb, high[divN], 1) and ta.valuewhen(pvHb, cvdHist[divN], 0) < ta.valuewhen(pvHb, cvdHist[divN], 1)
scWin = input.int(3, "Ventana de alineacion del score (velas)", minval = 1, maxval = 6, group = grpD)
f_recent(_c) => ta.barssince(_c) <= scWin - 1
maxSc = 1.0 + 1.5 + 1.5 + 1.0 + 1.0 + 2.0 + 1.5 + 1.5 + 1.0 + 1.0 + 0.5
sBuyRaw  = (f_recent(zexitL) ? 1.0 : 0) + (f_recent(deepL) ? 1.5 : 0) + (f_recent(k <= zone) ? 1.5 : 0) + (f_recent(flowOkL) ? 1.0 : 0) + (f_recent(cvd3 > 0) ? 1.0 : 0) + (f_recent(bullDiv) ? 2.0 : 0) + (htfSottCheapL ? 1.5 : 0) + (htfCvdBuyL ? 1.5 : 0) + (htfMacdBull ? 1.0 : 0) + (f_recent(macdXup) ? 1.0 : 0) + (tp2okL ? 0.5 : 0)
sSellRaw = (f_recent(zexitS) ? 1.0 : 0) + (f_recent(deepS) ? 1.5 : 0) + (f_recent(k >= 100 - zone) ? 1.5 : 0) + (f_recent(flowOkS) ? 1.0 : 0) + (f_recent(cvd3 < 0) ? 1.0 : 0) + (f_recent(bearDiv) ? 2.0 : 0) + (htfSottExpS ? 1.5 : 0) + (htfCvdSellS ? 1.5 : 0) + (htfMacdBear ? 1.0 : 0) + (f_recent(macdXdn) ? 1.0 : 0) + (tp2okS ? 0.5 : 0)
buyScore  = int(math.round(sBuyRaw / maxSc * 100))
sellScore = int(math.round(sSellRaw / maxSc * 100))
plotshape(bullDiv and not bullDiv[1], "Divergencia alcista (delta)", style = shape.cross, location = location.belowbar, color = color.new(color.green, 0), size = size.tiny)
plotshape(bearDiv and not bearDiv[1], "Divergencia bajista (delta)", style = shape.cross, location = location.abovebar, color = color.new(color.red, 0), size = size.tiny)
score_lbl_long() =>
    if showScore and longNew
        label.new(bar_index, low,  str.tostring(buyScore) + "%",  yloc = yloc.belowbar, color = buyScore  >= scoreThr ? color.new(color.green, 0) : color.new(color.green, 60), textcolor = color.white, style = label.style_label_up,   size = size.tiny)
    0

score_lbl_short() =>
    if showScore and shortNew
        label.new(bar_index, high, str.tostring(sellScore) + "%", yloc = yloc.abovebar, color = sellScore >= scoreThr ? color.new(color.red, 0)   : color.new(color.red, 60),   textcolor = color.white, style = label.style_label_down, size = size.tiny)
    0

alertcondition(longNew  and buyScore  >= scoreThr, "TQQQ COMPRA confiable (score)", "TQQQ LONG score alto; sin probabilidad calibrada")
alertcondition(shortNew and sellScore >= scoreThr, "TQQQ VENTA confiable (score)",  "TQQQ entrada SHORT con score alto")

// --- proporcion de flujo en vivo (tabla) ---
// __PRIMA_EN_EL_PINE_2026_09_22__ — la prima de Coinbase llega en la cadena como
// 'PR:<z>:<L|S|->'. Es el unico indicador NO derivado del precio que sobrevivio la
// validacion: 15 de 15 monedas fuera de muestra positivas, la pata CORTA tambien gana
// (+1.91 %/op) y correlacion +0.20 con la ruptura lenta, que es lo que la hace valiosa.
//
// PERO NO ES UN GATILLO DE ESTA TEMPORALIDAD, y por eso no toca ninguna decision del
// indicador: rinde a 8 DIAS de tenencia (+3.04 %/op) y se desarma al acortar (+0.43 a
// 1 dia). Medida contra las 2.420 operaciones cerradas de los brazos (~3 h), operar a
// favor contra en contra da -0.074 %/op con t -0.42: cero efecto. Se muestra como
// CONTEXTO -- de donde viene la demanda -- y la celda lo dice con todas las letras.
// __VOL_OBJETIVO_2026_09_22__ — multiplicador de tamano por volatilidad, campo 'VO'.
// La UNICA mejora del proyecto que supero una vara pedida (+50 %): sobre la cartera
// pre-registrada, Sharpe 0,73 -> 1,02, drawdown -36,0 % -> -26,4 %, g_max 26,4 ->
// 51,8 %/anio. Sin apalancar nada (tope 1x) da +37 %. Robusto en ventanas 30/60/90/120
// y en las dos mitades; funding MEDIDO -0,58 %/anio, ya descontado.
// NO cambia ninguna senal de este indicador: es informacion de regimen.
volObj = valor_de(BLOQUE, "VO")
volCs = campos_de(BLOQUE, "VO")
volReg = array.size(volCs) > 1 ? array.get(volCs, 1) : "-"
primaZ = valor_de(BLOQUE, "PR")
primaCs = campos_de(BLOQUE, "PR")
primaLado = array.size(primaCs) > 1 ? array.get(primaCs, 1) : "-"
hayPrima = array.size(primaCs) > 0
score_lbl_long()
score_lbl_short()

alertcondition(longNew,  "TQQQ SWING LONG",  "TQQQ LONG salida de extremo z + SOTT")
alertcondition(shortNew, "TQQQ SWING SHORT", "TQQQ SHORT salida de extremo z + SOTT")
alertcondition(longNew or shortNew, "TQQQ SWING (cualquiera)", "TQQQ senal de swing (reversion) - ver direccion en el grafico")
alertcondition(longAplus or shortAplus, "TQQQ SWING A+ (alta confianza)", "TQQQ swing A+ (giro profundo z2 + CVD confirma) - alta confianza")

// =============================================================================
//  TOQUE: CALIBRADO __ALCANCE_CALIBRADO_2026_10_05__
//  Antes decia "sin calibrar" porque no habia un manifiesto medido para este
//  horizonte. Ya lo hay: tasa BASE empirica por celda de (distancia x ATR), 41
//  activos, velas de 1 h, entre 17.000 y 178.000 observaciones POR CELDA.
//  Script: forward_test/bt_calibrar_alcance_20261005.py
//
//  QUE ES Y QUE NO ES. Es la probabilidad de que el precio PASE por ese nivel,
//  o sea lo que hace cualquier precio a esa distancia con esa volatilidad. NO es
//  un merito del nivel ni una probabilidad de rebote: ninguna familia sirve de
//  barrera (ver el ranking de familias mas arriba). Es la vara contra la cual un
//  nivel tendria que destacarse, y sirve para elegir DESTINO, no para esperar
//  que frene ahi.
//
//  La tabla se midio en velas de 1 h, asi que la volatilidad se lee SIEMPRE en
//  1 h (request.security) aunque el grafico este en otra temporalidad.
GRP_R = "Toque - calibrado 2026-10-05"
showReach = input.bool(true, "Mostrar probabilidad de toque (3h / 24h)", group = GRP_R)
float _atrR = ta.atr(14)                                   // ATR del grafico: lo usa el dibujo de zonas
//  UNA sola llamada a request.security devolviendo tupla: cada llamada cuesta ~1.470 tokens
//  del limite de TradingView (CE10117), asi que pedir ATR y cierre por separado se iba de rango.
[_atr1h, _cls1h] = request.security(syminfo.tickerid, "60", [ta.atr(14), close], lookahead = barmerge.lookahead_off)
//  __TOKENS_RE10117_2026_10_06__ DOS cosas aprendidas CONTRA TradingView (no contra el estimador):
//   1. las CADENAS DE TEXTO literales son caras: 28 textos armados costaron +615 tokens reales.
//      -> la tabla va en NUMEROS empaquetados (3h*100 + 24h), que es lo barato.
//   2. Pine INLINEA la funcion entera en cada llamada -> lo que este adentro se paga N veces.
//      -> la franja de volatilidad y los 7 textos del dia se calculan UNA vez por barra, afuera,
//         y la funcion solo hace: distancia -> franja -> array.get.
//  Orden: por cada franja de distancia (7), las 4 franjas de ATR.
var int[] ALCANCE = array.from(8896, 9598, 9699, 9899, 4981, 7391, 8194, 8896, 2164, 4479, 5985, 7390, 845, 2165, 3575, 5383, 333, 1053, 2165, 3875, 220, 438, 1052, 2465, 9, 121, 332, 948)
float _volPct = na(_atr1h) or na(_cls1h) or _cls1h <= 0 ? na : 100.0 * _atr1h / _cls1h
int _colVol = na(_volPct) ? -1 : _volPct < 0.6 ? 0 : _volPct < 1.0 ? 1 : _volPct < 1.6 ? 2 : 3
bool _okReach = showReach and _colVol >= 0 and close > 0
var string[] TXT7 = array.new<string>(7, "")
if _okReach
    for _i = 0 to 6
        int _p = array.get(ALCANCE, _i * 4 + _colVol)
        array.set(TXT7, _i, "  " + str.tostring(math.floor(_p / 100)) + "%/3h " + str.tostring(_p % 100) + "%/24h")
f_reachTxt(float lvl) =>
    string _out = ""
    if _okReach and not na(lvl)
        float _d = math.abs(lvl / close - 1.0) * 100.0
        int _fi = _d < 0.25 ? 0 : _d < 0.5 ? 1 : _d < 1.0 ? 2 : _d < 1.5 ? 3 : _d < 2.0 ? 4 : _d < 3.0 ? 5 : _d < 5.0 ? 6 : -1
        if _fi >= 0
            _out := array.get(TXT7, _fi)
    _out

// =============================================================================
//  PARTE 2 · NIVELES DE SESION + PDH/PDL/PWH/PWL  (oculta los YA barridos)
// =============================================================================
GS = "Niveles de sesion / liquidez"
sysLvls = input.bool(false, "Niveles sueltos: dia/semana/Asia/Londres", group=GS)
sysHideSwept = input.bool(true, "Ocultar niveles YA liquidados (barridos)", group=GS)
kzTkS = input.int(0,  "Asia inicio UTC",    minval=0, maxval=23, group=GS)
kzTkE = input.int(8,  "Asia fin UTC",       minval=0, maxval=23, group=GS)
kzLoS = input.int(8,  "Londres inicio UTC", minval=0, maxval=23, group=GS)
kzLoE = input.int(13, "Londres fin UTC",    minval=0, maxval=23, group=GS)
hUTC  = hour(time, "UTC")
inTok = kzTkE < kzTkS ? (hUTC >= kzTkS or hUTC < kzTkE) : (hUTC >= kzTkS and hUTC < kzTkE)
inLdn = hUTC >= kzLoS and hUTC < kzLoE
// Mismo motivo que arriba: una llamada por PAR en vez de una por nivel.
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
var float asiaH = na
var float asiaL = na
var float ldnH = na
var float ldnL = na
if inTok and not inTok[1]
    asiaH := high
    asiaL := low
else if inTok
    asiaH := math.max(nz(asiaH, high), high)
    asiaL := math.min(nz(asiaL, low), low)
if inLdn and not inLdn[1]
    ldnH := high
    ldnL := low
else if inLdn
    ldnH := math.max(nz(ldnH, high), high)
    ldnL := math.min(nz(ldnL, low), low)
var bool pdhTk = false
var bool pdlTk = false
var bool pwhTk = false
var bool pwlTk = false
var bool asHTk = false
var bool asLTk = false
var bool ldHTk = false
var bool ldLTk = false
if ta.change(time("D")) != 0
    pdhTk := false
    pdlTk := false
if ta.change(time("W")) != 0
    pwhTk := false
    pwlTk := false
if inTok and not inTok[1]
    asHTk := false
    asLTk := false
if inLdn and not inLdn[1]
    ldHTk := false
    ldLTk := false
if not na(pdh) and high >= pdh
    pdhTk := true
if not na(pdl) and low <= pdl
    pdlTk := true
if not na(pwh) and high >= pwh
    pwhTk := true
if not na(pwl) and low <= pwl
    pwlTk := true
if not na(asiaH) and not inTok and high >= asiaH
    asHTk := true
if not na(asiaL) and not inTok and low <= asiaL
    asLTk := true
if not na(ldnH) and not inLdn and high >= ldnH
    ldHTk := true
if not na(ldnL) and not inLdn and low <= ldnL
    ldLTk := true
f_show(bool tk) => not sysHideSwept or not tk
var label[] sysLb = array.new<label>()
f_sysLvl(float p, string t, color c) =>
    if not na(p)
        //  sin alcance a proposito: PDH/PDL y PWH/PWL midieron edge NEGATIVO contra su base
        //  (−0,60 y −2,26 pp). Ademas cada llamada a f_reachTxt se inlinea entera (tokens).
        sysLb.push(label.new(bar_index + 8, p, t, style=label.style_none, textcolor=c, size=size.tiny))
sesion_dibujar() =>
    if barstate.islast and sysLvls and zzDetails
        while sysLb.size() > 0
            sysLb.pop().delete()
        if f_show(pdhTk)
            f_sysLvl(pdh, "PDH", color.orange)
        if f_show(pdlTk)
            f_sysLvl(pdl, "PDL", color.orange)
        if f_show(pwhTk)
            f_sysLvl(pwh, "PWH", color.fuchsia)
        if f_show(pwlTk)
            f_sysLvl(pwl, "PWL", color.fuchsia)
        if f_show(asHTk)
            f_sysLvl(asiaH, "Asia H", color.aqua)
        if f_show(asLTk)
            f_sysLvl(asiaL, "Asia L", color.aqua)
        if f_show(ldHTk)
            f_sysLvl(ldnH, "Ldn H", color.new(color.blue, 0))
        if f_show(ldLTk)
            f_sysLvl(ldnL, "Ldn L", color.new(color.blue, 0))

    // =============================================================================
    //  PARTE 3 · SWEEP-FADE NY<-Londres (grado A/B original; eficacia causal no demostrada)
    // =============================================================================
    0

sfOn    = input.bool(true,  "Sweep-fade NY<-Londres (senales)", group=GS)
sfLoS   = input.int(8,  "  Londres inicio UTC (rango a barrer)", minval=0, maxval=23, group=GS)
sfLoE   = input.int(13, "  Londres fin UTC",                     minval=0, maxval=23, group=GS)
sfPost  = input.int(14, "  NY: entrada valida desde UTC (14=11h AR)", minval=0, maxval=23, group=GS)
sfNyE   = input.int(21, "  NY fin UTC",                          minval=0, maxval=23, group=GS)
sfAonly = input.bool(false, "  Solo grado A (ambos extremos barridos)", group=GS)
sfBufP  = input.float(0.1, "  Buffer stop %", minval=0.0, maxval=1.0, step=0.05, group=GS)
inSfLdn = hUTC >= sfLoS and hUTC < sfLoE
inSfNY  = hUTC >= sfPost and hUTC < sfNyE
inSfDet = hUTC >= (sfPost - 1) and hUTC < sfNyE
var float sfH = na
var float sfL = na
if inSfLdn and not inSfLdn[1]
    sfH := high
    sfL := low
else if inSfLdn
    sfH := math.max(nz(sfH, high), high)
    sfL := math.min(nz(sfL, low), low)
sfMid = na(sfH) or na(sfL) ? na : (sfH + sfL) / 2.0
var bool  sfSwL  = false
var bool  sfSwH  = false
var float sfExtL = na
var float sfExtH = na
if ta.change(time("D")) != 0
    sfSwL  := false
    sfSwH  := false
    sfExtL := na
    sfExtH := na
if inSfDet and not na(sfL) and low < sfL
    sfSwL  := true
    sfExtL := na(sfExtL) ? low : math.min(sfExtL, low)
if inSfDet and not na(sfH) and high > sfH
    sfSwH  := true
    sfExtH := na(sfExtH) ? high : math.max(sfExtH, high)
sfBoth = sfSwL and sfSwH
sfRecL = sfSwL and inSfNY and close > sfL and close[1] <= sfL
sfRecH = sfSwH and inSfNY and close < sfH and close[1] >= sfH
sfGrOK = not sfAonly or sfBoth
sfLongSig  = sfOn and sfRecL and sfGrOK
sfShortSig = sfOn and sfRecH and sfGrOK
sfStopL = na(sfExtL) ? na : sfExtL * (1 - sfBufP / 100.0)
sfStopH = na(sfExtH) ? na : sfExtH * (1 + sfBufP / 100.0)
sf_lbl_long() =>
    if sfLongSig
        label.new(bar_index, low, "SF up " + (sfBoth ? "A" : "B"), yloc=yloc.belowbar, style=label.style_label_up, color=sfBoth ? color.lime : color.new(color.green, 40), textcolor=color.black, size=size.small, tooltip="Sweep-fade LONG - stop " + str.tostring(sfStopL))
    0

sf_lbl_short() =>
    if sfShortSig
        label.new(bar_index, high, "SF dn " + (sfBoth ? "A" : "B"), yloc=yloc.abovebar, style=label.style_label_down, color=sfBoth ? color.red : color.new(color.maroon, 40), textcolor=color.white, size=size.small, tooltip="Sweep-fade SHORT - stop " + str.tostring(sfStopH))
    0

var line  sfHln = na
var line  sfLln = na
var line  sfMln = na
var label sfMlb = na
sf_dibujar() =>
    line.delete(sfHln)
    line.delete(sfLln)
    line.delete(sfMln)
    label.delete(sfMlb)
    line h = line.new(bar_index - 40, sfH,   bar_index + 8, sfH,   color=color.new(color.blue, 25), style=sfSwH ? line.style_dotted : line.style_solid)
    line l = line.new(bar_index - 40, sfL,   bar_index + 8, sfL,   color=color.new(color.blue, 25), style=sfSwL ? line.style_dotted : line.style_solid)
    line m = line.new(bar_index - 40, sfMid, bar_index + 8, sfMid, color=color.new(color.gray, 35), style=line.style_dashed)
    label lb = label.new(bar_index + 8, sfMid, "Ldn mid (target)" + (sfBoth ? "  A doble-grab" : (sfSwL or sfSwH ? "  B" : "")), style=label.style_none, textcolor=color.gray, size=size.tiny)
    [h, l, m, lb]

if barstate.islast and sfOn and not na(sfH) and zzDetails
    [_h, _l, _m, _lb] = sf_dibujar()
    sfHln := _h
    sfLln := _l
    sfMln := _m
    sfMlb := _lb

alertcondition(sfLongSig,  title="Sweep-fade LONG",  message="SWEEP-FADE LONG: NY barrio el minimo de Londres y reclamo -> fade al mid/maximo")
alertcondition(sfShortSig, title="Sweep-fade SHORT", message="SWEEP-FADE SHORT: NY barrio el maximo de Londres y reclamo -> fade al mid/minimo")

// =============================================================================
//  PARTE 4 · PERFIL DE VOLUMEN 24h ROLLING + VWAP 24h +/-k*sigma
//  ★ ES EL PERFIL QUE ALIMENTA LA CONFLUENCIA: su POC / VAH / VAL se vuelcan al
//    agrupador de zonas de la PARTE 6, y su volumen EN DINERO por precio decide
//    la opacidad de cada zona.
// =============================================================================
vp_use_24h = input.bool(true, 'Perfil de volumen = ultimas 24h (ROLLING, no se reinicia)', group = 'Lookback Period')
vp_use_visible_range = input.bool(false, 'Use Visible Range', group = 'Lookback Period')
vp_lookback_depth = input.int(200, minval = 10, maxval = 3000, title = 'Fixed Range Lookback Depth [10-3000]', group = 'Lookback Period')
vp_num_bars = input.int(200, minval = 10, maxval = 400, title = 'Number of Volume Bars [10-400]', group = 'Volume Bars')
vp_bar_thickness = input.int(1, minval = 1, maxval = 30, title = 'Volume Bar Thickness [1-30]', group = 'Volume Bars')
vp_bar_len_mult = input.int(20, minval = 1, maxval = 50, title = 'Bar Length Multiplier [1-50]', group = 'Volume Bars')
vp_right_offset = input.int(70, minval = 0, maxval = 400, title = 'Right Offset [0-400]', group = 'Volume Bars')
vp_volume_type = input.string('Both', title = 'Volume Type', options = ['Both', 'Bullish', 'Bearish'], group = 'Volume Bars')
vp_bar_color = input.color(color.new(color.gray, 50), title = 'Volume Bar Color (si Delta esta OFF)', group = 'Volume Bars')
vp_color_by_delta = input.bool(true, title = 'Colorear barras por DELTA (compra vs venta)', group = 'Volume Bars')
vp_buy_color = input.color(#26a69a, title = 'Color COMPRA (delta +)', group = 'Volume Bars')
vp_sell_color = input.color(#ef5350, title = 'Color VENTA (delta -)', group = 'Volume Bars')
vp_display_poc = input.bool(true, title = 'Display Point of Control (PoC)', group = 'Point of Control')
vp_poc_extend = input.bool(true, title = 'Extender POC a la derecha + etiqueta (nivel objetivo)', group = 'Point of Control')
vp_poc_line_thickness = input.int(2, minval = 1, maxval = 30, title = 'PoC Line Thickness [1-30]', group = 'Point of Control')
vp_poc_line_color = input.color(color.red, title = 'PoC Line Color', group = 'Point of Control')
vp_display_va = input.bool(true, title = 'Display Value Area', group = 'Value Area')
vp_va_percent = input.int(68, minval = 5, maxval = 95, title = 'Value Area Percentage(%) [5-95]', group = 'Value Area')
vp_va_bar_color = input.color(color.blue, title = 'Value Area Bar Color', group = 'Value Area')
vp_display_va_lines = input.bool(true, title = 'Display Value Area Lines', group = 'Value Area')
vp_va_lines_thickness = input.int(1, minval = 1, maxval = 20, title = 'Value Area Lines Thickness [1-20]', group = 'Value Area')
vwap_show = input.bool(true,  'Mostrar VWAP 24h + bandas', group = 'VWAP 24h Rolling')
vwap_k    = input.float(2.5,  'Desvio de las bandas (sigma)', step = 0.5, minval = 0.5, group = 'VWAP 24h Rolling')
// __VWAP_PENDIENTE_2026_09_21__
vwap_color   = input.bool(true, 'Colorear el VWAP por pendiente (verde sube / rojo baja / amarillo neutro)', group = 'VWAP 24h Rolling')
vwap_pend_n  = input.int(8, 'Velas para medir la pendiente', minval = 2, maxval = 200, group = 'VWAP 24h Rolling')
vwap_pend_um = input.float(0.25, 'Umbral neutro (en ATR de 14)', step = 0.05, minval = 0.0, group = 'VWAP 24h Rolling',
     tooltip = 'La pendiente se normaliza por ATR para que el umbral valga igual en BTC que en DOGE. Neutro = el VWAP se movio menos que este multiplo del ATR en la ventana.')

var int timeframe_minutes = 1000 * timeframe.in_seconds()
int bars_24h = math.min(1500, math.max(10, int(86400 / timeframe.in_seconds())))
var int lookback_bars = vp_use_visible_range ? math.round((last_bar_time - chart.left_visible_bar_time) / timeframe_minutes) : (vp_use_24h ? bars_24h : vp_lookback_depth)
int _tf_min_real = math.max(1, int(timeframe.in_seconds() / 60))
int adj_right_offset = math.max(30, math.round(vp_right_offset * 5.0 / _tf_min_real))

var line poc = na
var line vah = na
var line val = na
var label poc_lbl = na
var array<line> bars = array.new_line()
var array<float> volumes = array.new_float(vp_num_bars, 0)
var array<float> vol_buy = array.new_float(vp_num_bars, 0)
var array<float> vol_sell = array.new_float(vp_num_bars, 0)

// ★ NIVELES DEL PERFIL EXPUESTOS: los llena draw() y los consume el agrupador de
//   zonas de la PARTE 6. Asi la confluencia usa el perfil de 24h de verdad.
var float vp_poc_y = na
var float vp_vah_y = na
var float vp_val_y = na

float vpHighSeries = ta.highest(lookback_bars)
float vpLowSeries = ta.lowest(lookback_bars)
float highest_price = barstate.isconfirmed ? vpHighSeries : vpHighSeries[1]
float lowest_price = barstate.isconfirmed ? vpLowSeries : vpLowSeries[1]
float price_interval = (highest_price - lowest_price) / (vp_num_bars - 1)

float _tp     = hlc3
float _sumV   = math.sum(volume, bars_24h)
float _sumPV  = math.sum(_tp * volume, bars_24h)
float _sumP2V = math.sum(_tp * _tp * volume, bars_24h)
float rvwap   = _sumV > 0 ? _sumPV / _sumV : _tp
float _rvar   = _sumV > 0 ? math.max(_sumP2V / _sumV - rvwap * rvwap, 0.0) : 0.0
float rsig    = math.sqrt(_rvar)
float vwap_up = rvwap + vwap_k * rsig
float vwap_dn = rvwap - vwap_k * rsig

// __VWAP_PENDIENTE_2026_09_21__ — el VWAP se pinta por TRAMOS segun hacia donde apunta.
// La pendiente se normaliza por ATR(14): asi el mismo umbral sirve en un activo de
// 86.000 USD y en uno de 0,09 USD. Sin normalizar, el umbral habria que tocarlo por
// simbolo y el indicador miente en los baratos.
float _vw_atr  = ta.atr(14)
float _vw_pend = _vw_atr > 0 ? (rvwap - rvwap[vwap_pend_n]) / _vw_atr : 0.0
int   _vw_dir  = _vw_pend >  vwap_pend_um ?  1 : _vw_pend < -vwap_pend_um ? -1 : 0
color _vw_col  = not vwap_color ? color.new(#B800D9, 0) :
     _vw_dir ==  1 ? color.new(#26A69A, 0) :
     _vw_dir == -1 ? color.new(#EF5350, 0) :
                     color.new(#FFB300, 0)

plot(vwap_show and zzDetails ? rvwap   : na, 'VWAP 24h',      color = _vw_col,                linewidth = 3)
plot(vwap_show and zzDetails ? vwap_up : na, 'VWAP +k sigma', color = color.new(#B800D9, 25), linewidth = 1)
plot(vwap_show and zzDetails ? vwap_dn : na, 'VWAP -k sigma', color = color.new(#B800D9, 25), linewidth = 1)

scale_volume(vol, max) =>
    float poc_len = math.min(288.0 * vp_bar_len_mult / 100.0, adj_right_offset - 4)
    int scaled_vol = max > 0 ? math.round(vol / max * poc_len) : 0
    scaled_vol

calculate_vp() =>
    array.fill(volumes, 0)
    array.fill(vol_buy, 0)
    array.fill(vol_sell, 0)
    for i = (barstate.isconfirmed ? 0 : 1) to (lookback_bars - 1 + (barstate.isconfirmed ? 0 : 1))
        for j = 0 to (vp_num_bars - 1)
            float price_level = lowest_price + price_interval * j
            bool is_bullish = close[i] >= open[i]
            bool include_vol = vp_volume_type == 'Both' ? true : (vp_volume_type == 'Bullish' ? is_bullish : not is_bullish)
            if (price_level >= low[i] and price_level < high[i] and include_vol)
                array.set(volumes, j, volumes.get(j) + volume[i])
                if is_bullish
                    array.set(vol_buy, j, vol_buy.get(j) + volume[i])
                else
                    array.set(vol_sell, j, vol_sell.get(j) + volume[i])

calculate_va(int max_idx, float max_vol) =>
    float sum_vol = volumes.sum()
    float va_vol = sum_vol * vp_va_percent / 100
    int va_up = max_idx
    int va_dn = max_idx
    float va_sum = max_vol
    while va_sum < va_vol
        float v_up = (va_up < vp_num_bars - 1) ? volumes.get(va_up + 1) : 0.0
        float v_dn = (va_dn > 0) ? volumes.get(va_dn - 1) : 0.0
        if v_up == 0 and v_dn == 0
            break
        if v_up >= v_dn
            va_sum += v_up
            va_up += 1
        else
            va_sum += v_dn
            va_dn -= 1
    [va_dn, va_up]

draw() =>
    float max_vol = volumes.max()
    int max_idx = volumes.indexof(max_vol)
    int x2 = bar_index + adj_right_offset
    for i = 0 to (vp_num_bars - 1)
        int vol = scale_volume(volumes.get(i), max_vol)
        int x1 = x2 - vol
        float y = lowest_price + price_interval * i
        line.set_xy1(bars.get(i), x1, y)
        line.set_xy2(bars.get(i), x2, y)
        color _bc = vp_bar_color
        if vp_color_by_delta
            float _tot = vol_buy.get(i) + vol_sell.get(i)
            float _dr = _tot > 0 ? (vol_buy.get(i) - vol_sell.get(i)) / _tot : 0.0
            _bc := _dr >= 0 ? color.from_gradient(_dr, 0.0, 1.0, color.new(color.gray, 60), vp_buy_color) : color.from_gradient(_dr, -1.0, 0.0, vp_sell_color, color.new(color.gray, 60))
        line.set_color(bars.get(i), max_idx == i ? vp_poc_line_color : _bc)
    float _pocY = lowest_price + price_interval * max_idx
    if vp_display_poc and zzDetails
        float y = _pocY
        int poc_x1 = bar_index - lookback_bars
        int poc_x2 = vp_poc_extend ? x2 : (x2 - scale_volume(max_vol, max_vol) - 10)
        line.set_xy1(poc, poc_x1, y)
        line.set_xy2(poc, poc_x2, y)
        if vp_poc_extend and not na(poc_lbl)
            label.set_xy(poc_lbl, x2, y)
            label.set_text(poc_lbl, 'POC ' + str.tostring(y, format.mintick) + f_reachTxt(y))
    [va_dn, va_up] = calculate_va(max_idx, max_vol)
    float _valY = lowest_price + price_interval * va_dn
    float _vahY = lowest_price + price_interval * va_up
    if vp_display_va
        for i = va_dn to va_up
            if i != max_idx and not vp_color_by_delta
                line.set_color(bars.get(i), vp_va_bar_color)
        if vp_display_va_lines and zzDetails
            int vah_vol = scale_volume(volumes.get(va_up), max_vol)
            int val_vol = scale_volume(volumes.get(va_dn), max_vol)
            int va_x1 = bar_index - lookback_bars
            int vah_x2 = x2 - vah_vol - 10
            int val_x2 = x2 - val_vol - 10
            line.set_xy1(vah, va_x1, _vahY)
            line.set_xy1(val, va_x1, _valY)
            line.set_xy2(vah, vah_x2, _vahY)
            line.set_xy2(val, val_x2, _valY)
    [_pocY, _valY, _vahY]

// DEVUELVE los objetos: una funcion de Pine no puede asignar una variable global
// (CE10088). `array.push(bars, ...)` si vale, porque MUTA el array, no lo reasigna.
perfil_init() =>
    line  p1 = na
    label p2 = na
    line  p3 = na
    line  p4 = na
    if barstate.isfirst
        for i = 0 to (vp_num_bars - 1)
            array.push(bars, line.new(x1 = bar_index, y1 = close, x2 = bar_index, y2 = close, width = vp_bar_thickness))
        if vp_display_poc and zzDetails
            p1 := line.new(x1 = bar_index, y1 = close, x2 = bar_index, y2 = close, color = vp_poc_line_color, width = vp_poc_line_thickness)
            p2 := label.new(x = bar_index, y = close, text = 'POC', style = label.style_label_left, color = color.new(vp_poc_line_color, 20), textcolor = color.white, size = size.small)
        if vp_display_va and vp_display_va_lines and zzDetails
            p3 := line.new(x1 = bar_index, y1 = close, x2 = bar_index, y2 = close, color = vp_va_bar_color, width = vp_va_lines_thickness)
            p4 := line.new(x1 = bar_index, y1 = close, x2 = bar_index, y2 = close, color = vp_va_bar_color, width = vp_va_lines_thickness)
    [p1, p2, p3, p4]

if barstate.isfirst
    [_p1, _p2, _p3, _p4] = perfil_init()
    poc     := _p1
    poc_lbl := _p2
    vah     := _p3
    val     := _p4

if barstate.islast
    calculate_vp()
    // draw() DEVUELVE el POC / VAL / VAH del perfil: se asignan aca, en el
    // ambito global, porque una funcion de Pine no puede escribir globales.
    [_pocOut, _valOut, _vahOut] = draw()
    vp_poc_y := _pocOut
    vp_val_y := _valOut
    vp_vah_y := _vahOut

// =============================================================================
//  PARTE 2b · TARGET (mitad al centro) + NIVELES NAKED nDOG / nPOC
//  TARGET mitad validado 2026-09-02 (bt_target_which): la mitad del camino al
//  centro se toca 48% vs POC/VWAP completo 5-6%.
// =============================================================================
GTG    = "Target + naked (se borran al tocar)"
tgShow = input.bool(true, "TARGET (mitad al centro VWAP) = linea AMARILLA", group = GTG)
tgNdog = input.bool(false, "nDOG SUELTO (OFF: se agrupa en las zonas de confluencia)", group = GTG)
tgNpoc = input.bool(false, "nPOC SUELTO (OFF: se agrupa en las zonas de confluencia)", group = GTG)
tgHide = input.bool(true, "Borrar el nivel cuando el precio lo BARRE", group = GTG)

// ---- 1) TARGET = mitad del camino al VWAP 24h desde la ultima senal de swing ----
var float tgLvl = na
var bool  tgIsL = false
if longNew
    tgLvl := close + (rvwap - close) * 0.5
    tgIsL := true
else if shortNew
    tgLvl := close + (rvwap - close) * 0.5
    tgIsL := false
if not na(tgLvl) and tgHide and ((tgIsL and high >= tgLvl) or (not tgIsL and low <= tgLvl))
    tgLvl := na

// ---- 2) nDOG = gap entre el CIERRE del dia previo y la APERTURA del nuevo dia ----
var float dogHi = na
var float dogLo = na
var bool  dogHiTk = false
var bool  dogLoTk = false
if ta.change(time("D")) != 0
    dogHi := math.max(close[1], open)
    dogLo := math.min(close[1], open)
    dogHiTk := false
    dogLoTk := false
if not na(dogHi) and high >= dogHi
    dogHiTk := true
if not na(dogLo) and low <= dogLo
    dogLoTk := true

// ---- 3) nPOC = POC del dia PREVIO ; naked hasta que el precio lo revisita ----
var map<float, float> npDayVol = map.new<float, float>()
var float nPoc   = na
var bool  nPocTk = false
_atrNp = ta.atr(14)
npGrid = (na(_atrNp) or _atrNp <= 0) ? syminfo.mintick : math.max(syminfo.mintick, _atrNp / 40.0)
_npKey = math.round(hlc3 / npGrid) * npGrid
if ta.change(time("D")) != 0
    if npDayVol.size() > 0
        float _bestK = na
        float _bestV = -1.0
        for [kk2, vv2] in npDayVol
            if vv2 > _bestV
                _bestV := vv2
                _bestK := kk2
        nPoc := _bestK
        nPocTk := false
    npDayVol.clear()
map.put(npDayVol, _npKey, nz(map.get(npDayVol, _npKey)) + volume)
if not na(nPoc) and high >= nPoc and low <= nPoc
    nPocTk := true

// ---- dibujo (se borran/redibujan cada vela; ocultar los barridos) ----
var line  tgLn = na
var label tgLb = na
var line  dgHl = na
var line  dgLl = na
var label dgHb = na
var label dgLb = na
var line  npLn = na
var label npLb = na
tg_dibujar() =>
    line.delete(tgLn)
    label.delete(tgLb)
    line.delete(dgHl)
    line.delete(dgLl)
    label.delete(dgHb)
    label.delete(dgLb)
    line.delete(npLn)
    label.delete(npLb)
    line a1 = na
    label a2 = na
    line b1 = na
    line b2 = na
    label b3 = na
    label b4 = na
    line c1 = na
    label c2 = na
    if zzDetails and tgShow and not na(tgLvl)
        a1 := line.new(bar_index - 30, tgLvl, bar_index + 8, tgLvl, color = color.new(color.yellow, 0), width = 2, style = line.style_dashed)
        a2 := label.new(bar_index + 8, tgLvl, "TARGET mitad", style = label.style_none, textcolor = color.yellow, size = size.tiny)
    if zzDetails and tgNdog and not na(dogHi) and (not tgHide or not dogHiTk)
        b1 := line.new(bar_index - 30, dogHi, bar_index + 8, dogHi, color = color.new(color.orange, 10), style = line.style_dotted)
        b3 := label.new(bar_index + 8, dogHi, "nDOG H", style = label.style_none, textcolor = color.orange, size = size.tiny)
    if zzDetails and tgNdog and not na(dogLo) and (not tgHide or not dogLoTk)
        b2 := line.new(bar_index - 30, dogLo, bar_index + 8, dogLo, color = color.new(color.orange, 10), style = line.style_dotted)
        b4 := label.new(bar_index + 8, dogLo, "nDOG L", style = label.style_none, textcolor = color.orange, size = size.tiny)
    if zzDetails and tgNpoc and not na(nPoc) and (not tgHide or not nPocTk)
        c1 := line.new(bar_index - 30, nPoc, bar_index + 8, nPoc, color = color.new(color.red, 0), width = 2, style = line.style_solid)
        c2 := label.new(bar_index + 8, nPoc, "nPOC " + str.tostring(nPoc, format.mintick), style = label.style_none, textcolor = color.red, size = size.tiny)
    [a1, a2, b1, b2, b3, b4, c1, c2]

if barstate.islast
    [_a1, _a2, _b1, _b2, _b3, _b4, _c1, _c2] = tg_dibujar()
    tgLn := _a1
    tgLb := _a2
    dgHl := _b1
    dgLl := _b2
    dgHb := _b3
    dgLb := _b4
    npLn := _c1
    npLb := _c2

sesion_dibujar()
sf_lbl_long()
sf_lbl_short()

