zzSmcOn = input.bool(true, "Integrar FVG / iFVG / BPR del grafico", group = GZ)
zzAlertOn = input.bool(true, "Alertar toque de zona clave al cierre", group = GZ)
zzVolMult = input.float(1.0, "Ruptura: volumen / media20 previa >", minval = 0.1, step = 0.1, group = GZ)
